# Copy to .env and adjust.  cp .env.example .env

# --- Database (PostgreSQL) ---------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajaia"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ajaia"
# Neon: DATABASE_URL = pooled connection string (host contains "-pooler"),
#       DATABASE_URL_UNPOOLED   = direct (unpooled) connection string. Both need ?sslmode=require

# Optional: separate database used by the integration test (npm test).
# The test is skipped when this is not set. It WIPES this database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajaia_test"

# --- Sessions ----------------------------------------------------------------
# Secret used to sign session cookies. At least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
